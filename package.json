{
  "name": "ratemyplate",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "deploy": "npm run build && wrangler deploy --config wrangler.jsonc",
    "preview:worker": "npm run build && wrangler dev --config wrangler.jsonc",
    "check": "svelte-kit sync && svelte-check --tsconfig ./jsconfig.json"
  },
  "devDependencies": {
    "@sveltejs/adapter-cloudflare": "^7.2.10",
    "@sveltejs/kit": "^2.46.0",
    "@sveltejs/vite-plugin-svelte": "^6.0.0",
    "svelte": "^5.38.0",
    "svelte-check": "^4.3.1",
    "typescript": "^5.8.3",
    "vite": "^7.1.7"
  },
  "dependencies": {
    "appwrite": "^29.4.0",
    "lucide-svelte": "^0.545.0"
  }
}
